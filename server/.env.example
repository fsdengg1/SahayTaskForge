# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL — keep this file on the server only. Never put DATABASE_URL in the React app.
# Put the real Aiven (or other) URL in server/.env only. Do not commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# Initial admin (used only by prisma seed)
ADMIN_NAME=System Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sahayracks.local
ADMIN_PASSWORD=ChangeMe@123

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
