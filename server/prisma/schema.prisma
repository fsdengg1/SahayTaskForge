generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  tasks            Task[]
  projectMembers   ProjectMember[]
  productionOps    ProductionOperationConfig[]
  stageWeights     StageWeight[]
  issues           Issue[]  @relation("IssueDepartment")
  blockedIssues    Issue[]  @relation("IssueBlockedDepartment")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isManagement Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  active       Boolean   @default(true)
  mustChangePassword Boolean @default(false)
  departmentId String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  roles      UserRole[]

  salesLeads              Lead[]                 @relation("LeadSalesPerson")
  completedLeadOutputs    Lead[]                 @relation("LeadOutputCompletedBy")
  followUps               LeadFollowUp[]
  managedProjects         Project[]              @relation("ProjectManager")
  salesProjects           Project[]              @relation("ProjectSalesPerson")
  projectMemberships      ProjectMember[]
  assignedTasks           Task[]                 @relation("TaskAssignee")
  createdTasks            Task[]                 @relation("TaskCreator")
  comments                Comment[]
  documents               Document[]
  notifications           Notification[]
  activityLogs            ActivityLog[]
  auditLogs               AuditLog[]
  approvalsSubmitted      Approval[]             @relation("ApprovalSubmitter")
  approvalsReviewed       Approval[]             @relation("ApprovalReviewer")
  inspections             QualityInspection[]
  punchPoints             PunchPoint[]
  assignedIssues          Issue[]                @relation("IssueAssignee")
  createdIssues           Issue[]                @relation("IssueCreator")
  actionIssues            Issue[]                @relation("IssueActionOwner")
  closedProjects          Project[]              @relation("ProjectClosedBy")
  checklistCompletions    LeadChecklistItem[]
  installationVisits      InstallationVisit[]
  handovers               Handover[]             @relation("HandoverSahayRep")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ---------------------------------------------------------------------------
// Configurable lookups — never hard-code these in the UI
// ---------------------------------------------------------------------------

model Lookup {
  id        String   @id @default(uuid())
  type      String
  code      String
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  color     String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, code])
  @@index([type, active, sortOrder])
}

model NumberSequence {
  id        String @id @default(uuid())
  key       String @unique
  prefix    String
  padLength Int    @default(3)
  current   Int    @default(0)
}

model AppSetting {
  id    String @id @default(uuid())
  key   String @unique
  value Json
}

model StageWeight {
  id           String     @id @default(uuid())
  stageCode    String     @unique
  label        String
  weight       Decimal    @db.Decimal(5, 2)
  sortOrder    Int        @default(0)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
}

model ClosureCondition {
  id          String  @id @default(uuid())
  code        String  @unique
  label       String
  required    Boolean @default(true)
  sortOrder   Int     @default(0)
}

model ProductionOperationConfig {
  id           String      @id @default(uuid())
  code         String      @unique
  name         String
  sortOrder    Int         @default(0)
  active       Boolean     @default(true)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id            String   @id @default(uuid())
  customerId    String   @unique
  companyName   String
  industry      String?
  address       String?
  phone         String?
  email         String?
  notes         String?
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts CustomerContact[]
  sites    CustomerSite[]
  leads    Lead[]
  projects Project[]

  @@index([companyName])
  @@index([customerId])
}

model CustomerContact {
  id           String   @id @default(uuid())
  customerId   String
  name         String
  designation  String?
  mobile       String?
  email        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leads    Lead[]
  projects Project[]
  followUps LeadFollowUp[]

  @@index([customerId])
}

model CustomerSite {
  id           String   @id @default(uuid())
  customerId   String
  name         String
  address      String?
  plantType    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leads    Lead[]
  projects Project[]

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Leads (pre-sales)
// ---------------------------------------------------------------------------

model Lead {
  id                   String    @id @default(uuid())
  leadId               String    @unique
  leadDate             DateTime  @default(now())
  sourceCode           String?
  customerId           String
  contactId            String?
  siteId               String?
  industry             String?
  salesPersonId        String?
  priorityCode         String?
  statusCode           String
  nextFollowUpDate     DateTime?
  customerNeed         String?
  expectedOrderDate    DateTime?
  remarks              String?
  expectedProjectDate  DateTime?
  installationTimeline String?
  budgetCurrency       String    @default("INR")
  budgetAmount         Decimal?  @db.Decimal(14, 2)
  competitor           String?
  quotationRequiredBy  DateTime?
  decisionMaker        String?
  outputRequired       String?
  submissionDeadline   DateTime?
  outputStatus         String?
  outputCompletedAt    DateTime?
  outputCompletedById  String?
  outputDelayDays      Int?
  outputOnHold         Boolean   @default(false)
  holdReason           String?
  holdStartedAt        DateTime?
  holdEndedAt          DateTime?
  archived             Boolean   @default(false)
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer           Customer         @relation(fields: [customerId], references: [id])
  contact            CustomerContact? @relation(fields: [contactId], references: [id])
  site               CustomerSite?    @relation(fields: [siteId], references: [id])
  salesPerson        User?            @relation("LeadSalesPerson", fields: [salesPersonId], references: [id])
  outputCompletedBy  User?            @relation("LeadOutputCompletedBy", fields: [outputCompletedById], references: [id])
  requirement LeadRequirement?
  equipment   LeadEquipment[]
  checklist   LeadChecklistItem[]
  followUps   LeadFollowUp[]
  revisions   LeadRevision[]
  documents   Document[]
  comments    Comment[]
  projects    Project[]

  @@index([leadId])
  @@index([customerId])
  @@index([statusCode])
  @@index([salesPersonId])
  @@index([createdAt])
  @@index([nextFollowUpDate])
  @@index([priorityCode])
  @@index([submissionDeadline])
  @@index([outputRequired])
}

model LeadRequirement {
  id                   String  @id @default(uuid())
  leadId               String  @unique
  requirementType      String?
  materialToStore      String?
  storageMethodCode    String?
  requiredQuantity     String?
  noOfLevels           String?
  loadPerPalletKg      Decimal? @db.Decimal(12, 2)
  palletMaterialSize   String?
  rackLength           String?
  rackDepth            String?
  rackHeight           String?
  requiredRackHeight   String?
  availableAreaLength  String?
  availableAreaWidth   String?
  clearHeight          String?
  floorLoadingCapacity String?
  floorCondition       String?
  existingRacking      String?
  existingStorage      String?
  sitePhotosAvailable  Boolean @default(false)
  layoutAvailable      Boolean @default(false)
  equipmentAvailable   String?
  equipmentRequired    String?
  forkLengthCapacity   String?
  requiredLiftingHeight String?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadEquipment {
  id            String  @id @default(uuid())
  leadId        String
  equipmentCode String
  kind          String
  lead          Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, equipmentCode, kind])
}

model LeadChecklistItem {
  id          String    @id @default(uuid())
  leadId      String
  itemCode    String
  label       String
  completed   Boolean   @default(false)
  completedById String?
  completedAt DateTime?

  lead        Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  completedBy User? @relation(fields: [completedById], references: [id])

  @@unique([leadId, itemCode])
}

model LeadFollowUp {
  id               String    @id @default(uuid())
  leadId           String
  followUpDate     DateTime
  typeCode         String
  contactId        String?
  discussion       String?
  customerFeedback String?
  nextAction       String?
  nextFollowUpDate DateTime?
  salesPersonId    String?
  statusCode       String?
  remarks          String?
  createdAt        DateTime  @default(now())

  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact     CustomerContact? @relation(fields: [contactId], references: [id])
  salesPerson User?            @relation(fields: [salesPersonId], references: [id])

  @@index([leadId, followUpDate])
}

model LeadRevision {
  id               String   @id @default(uuid())
  leadId           String
  category         String
  revisionNumber   String
  reason           String?
  customerFeedback String?
  statusCode       String?
  documentId       String?
  createdById      String?
  createdAt        DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, category])
}

// ---------------------------------------------------------------------------
// Projects (execution)
// ---------------------------------------------------------------------------

model Project {
  id                    String    @id @default(uuid())
  projectId             String    @unique
  name                  String
  leadId                String?
  customerId            String
  contactId             String?
  siteId                String?
  salesPersonId         String?
  projectManagerId      String?
  productCategory       String?
  projectType           String?
  orderNumber           String?
  poNumber              String?
  poDate                DateTime?
  orderValue            Decimal?  @db.Decimal(14, 2)
  currency              String    @default("INR")
  startDate             DateTime?
  expectedCompletion    DateTime?
  actualCompletion      DateTime?
  priorityCode          String?
  currentStageCode      String
  currentStatusCode     String
  progressPercent       Decimal   @default(0) @db.Decimal(5, 2)
  remarks               String?
  archived              Boolean   @default(false)
  closureDate           DateTime?
  closedById            String?
  closureRemarks        String?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lead           Lead?            @relation(fields: [leadId], references: [id])
  customer       Customer         @relation(fields: [customerId], references: [id])
  contact        CustomerContact? @relation(fields: [contactId], references: [id])
  site           CustomerSite?    @relation(fields: [siteId], references: [id])
  salesPerson    User?            @relation("ProjectSalesPerson", fields: [salesPersonId], references: [id])
  projectManager User?            @relation("ProjectManager", fields: [projectManagerId], references: [id])
  closedBy       User?            @relation("ProjectClosedBy", fields: [closedById], references: [id])

  members         ProjectMember[]
  stages          ProjectStageRecord[]
  statusHistory   ProjectStatusHistory[]
  orders          Order[]
  tasks           Task[]
  documents       Document[]
  comments        Comment[]
  delays          DelayRecord[]
  issues          Issue[]
  rfqs            Rfq[]
  purchaseOrders  PurchaseOrder[]
  productionOrders ProductionOrder[]
  inspections     QualityInspection[]
  installations   Installation[]
  punchPoints     PunchPoint[]
  handovers       Handover[]
  invoices        Invoice[]
  approvals       Approval[]
  goodsReceipts   GoodsReceipt[]

  @@index([projectId])
  @@index([customerId])
  @@index([currentStageCode])
  @@index([currentStatusCode])
  @@index([projectManagerId])
  @@index([expectedCompletion])
  @@index([createdAt])
  @@index([leadId])
}

model ProjectMember {
  id           String     @id @default(uuid())
  projectId    String
  userId       String
  departmentId String?
  roleLabel    String?
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])

  @@unique([projectId, userId])
}

model ProjectStageRecord {
  id             String    @id @default(uuid())
  projectId      String
  stageCode      String
  statusCode     String    @default("NOT_STARTED")
  ownerId        String?
  startDate      DateTime?
  targetDate     DateTime?
  completedDate  DateTime?
  delayReason    String?
  remarks        String?
  sortOrder      Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageCode])
  @@index([projectId])
}

model ProjectStatusHistory {
  id         String   @id @default(uuid())
  projectId  String
  stageCode  String?
  statusCode String
  reason     String?
  changedBy  String?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Order {
  id          String   @id @default(uuid())
  projectId   String
  orderNumber String?
  poNumber    String?
  poDate      DateTime?
  value       Decimal? @db.Decimal(14, 2)
  currency    String   @default("INR")
  remarks     String?
  createdAt   DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   OrderItem[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  description String
  quantity    Decimal? @db.Decimal(12, 2)
  unit        String?
  unitPrice   Decimal? @db.Decimal(14, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id              String    @id @default(uuid())
  taskId          String    @unique
  projectId       String?
  leadId          String?
  name            String
  departmentId    String?
  assignedToId    String?
  createdById     String?
  createdAt       DateTime  @default(now())
  startDate       DateTime?
  dueDate         DateTime?
  completedDate   DateTime?
  statusCode      String    @default("NOT_STARTED")
  priorityCode    String    @default("MEDIUM")
  delayReason     String?
  delayCategory   String?
  remarks         String?
  module          String?
  sourceType      String?
  sourceId        String?

  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
  assignedTo User?       @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy  User?       @relation("TaskCreator", fields: [createdById], references: [id])
  updates    TaskUpdate[]
  comments   Comment[]
  blockers   TaskDependency[] @relation("BlockedTask")
  blocking   TaskDependency[] @relation("BlockingTask")

  @@index([taskId])
  @@index([projectId])
  @@index([assignedToId])
  @@index([statusCode])
  @@index([dueDate])
  @@index([departmentId])
}

model TaskDependency {
  id              String @id @default(uuid())
  taskId          String
  dependsOnTaskId String
  task            Task   @relation("BlockedTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn       Task   @relation("BlockingTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

model TaskUpdate {
  id        String   @id @default(uuid())
  taskId    String
  userId    String?
  message   String
  oldStatus String?
  newStatus String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model DelayRecord {
  id            String    @id @default(uuid())
  projectId     String?
  taskId        String?
  targetDate    DateTime?
  actualDate    DateTime?
  delayDays     Int?
  reason        String?
  ownerId       String?
  categoryCode  String?
  createdAt     DateTime  @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Issue {
  id                  String    @id @default(uuid())
  issueNumber         String    @unique
  projectId           String
  title               String
  description         String?
  issueType           String    @default("OTHER")
  departmentId        String?
  statusCode          String    @default("OPEN")
  priorityCode        String?
  assignedToId        String?
  createdById         String?
  dueDate             DateTime?
  resolvedAt          DateTime?
  isBlocking          Boolean   @default(false)
  blockedDepartmentId String?
  requiredAction      String?
  actionOwnerId       String?
  targetDate          DateTime?
  impactNotes         String?
  estimatedDelayDays  Int?
  resolutionNotes     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department        Department? @relation("IssueDepartment", fields: [departmentId], references: [id])
  blockedDepartment Department? @relation("IssueBlockedDepartment", fields: [blockedDepartmentId], references: [id])
  assignedTo        User?       @relation("IssueAssignee", fields: [assignedToId], references: [id])
  createdBy         User?       @relation("IssueCreator", fields: [createdById], references: [id])
  actionOwner       User?       @relation("IssueActionOwner", fields: [actionOwnerId], references: [id])
  comments          Comment[]
  documents         Document[]

  @@index([projectId])
  @@index([statusCode])
  @@index([priorityCode])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// Documents, approvals, comments, activity, audit
// ---------------------------------------------------------------------------

model Document {
  id             String    @id @default(uuid())
  documentId     String    @unique
  leadId         String?
  projectId      String?
  issueId        String?
  categoryCode   String
  fileName       String
  originalName   String
  mimeType       String?
  sizeBytes      Int?
  storagePath    String
  revision       String    @default("R0")
  approvalStatus String    @default("NONE")
  archived       Boolean   @default(false)
  uploadedById   String?
  uploadedAt     DateTime  @default(now())

  lead       Lead?    @relation(fields: [leadId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])
  issue      Issue?   @relation(fields: [issueId], references: [id])
  uploadedBy User?    @relation(fields: [uploadedById], references: [id])
  versions  DocumentVersion[]
  approvals Approval[]

  @@index([leadId])
  @@index([projectId])
  @@index([categoryCode])
  @@index([documentId])
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  revision    String
  fileName    String
  storagePath String
  uploadedById String?
  uploadedAt  DateTime @default(now())
  reason      String?
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Approval {
  id             String    @id @default(uuid())
  documentId     String?
  projectId      String?
  revision       String?
  submittedById  String?
  submittedAt    DateTime  @default(now())
  reviewerId     String?
  statusCode     String    @default("PENDING_REVIEW")
  approvedAt     DateTime?
  comments       String?

  document    Document? @relation(fields: [documentId], references: [id])
  project     Project?  @relation(fields: [projectId], references: [id])
  submittedBy User?     @relation("ApprovalSubmitter", fields: [submittedById], references: [id])
  reviewer    User?     @relation("ApprovalReviewer", fields: [reviewerId], references: [id])
}

model Comment {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  leadId     String?
  projectId  String?
  taskId     String?
  issueId    String?
  body       String
  userId     String?
  createdAt  DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  task    Task?    @relation(fields: [taskId], references: [id])
  issue   Issue?   @relation(fields: [issueId], references: [id])

  @@index([entityType, entityId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  userId      String?
  action      String
  entity      String
  entityId    String
  oldValue    String?
  newValue    String?
  description String?

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId, timestamp])
  @@index([timestamp])
}

model AuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  userId    String?
  ip        String?
  entity    String
  entityId  String
  action    String
  previous  Json?
  next      Json?

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([timestamp])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  title      String
  message    String
  type       String
  entityType String?
  entityId   String?
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ---------------------------------------------------------------------------
// Procurement
// ---------------------------------------------------------------------------

model Vendor {
  id             String   @id @default(uuid())
  vendorId       String   @unique
  companyName    String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  categories     String?
  active         Boolean  @default(true)
  performance    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotations     VendorQuotation[]
  purchaseOrders PurchaseOrder[]

  @@index([vendorId])
  @@index([companyName])
}

model Material {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  category    String?
  unit        String?
  makeOrBuy   String?
}

model Rfq {
  id          String    @id @default(uuid())
  rfqId       String    @unique
  projectId   String?
  title       String
  statusCode  String    @default("OPEN")
  dueDate     DateTime?
  remarks     String?
  createdAt   DateTime  @default(now())

  project     Project?          @relation(fields: [projectId], references: [id])
  quotations  VendorQuotation[]
}

model VendorQuotation {
  id          String    @id @default(uuid())
  rfqId       String
  vendorId    String
  amount      Decimal?  @db.Decimal(14, 2)
  currency    String    @default("INR")
  validUntil  DateTime?
  selected    Boolean   @default(false)
  remarks     String?
  createdAt   DateTime  @default(now())

  rfq    Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])
}

model PurchaseOrder {
  id               String    @id @default(uuid())
  poNumber         String    @unique
  projectId        String?
  vendorId         String
  statusCode       String    @default("DRAFT")
  orderDate        DateTime  @default(now())
  expectedDelivery DateTime?
  actualDelivery   DateTime?
  currency         String    @default("INR")
  totalAmount      Decimal?  @db.Decimal(14, 2)
  remarks          String?
  createdAt        DateTime  @default(now())

  project Project?           @relation(fields: [projectId], references: [id])
  vendor  Vendor             @relation(fields: [vendorId], references: [id])
  items   PurchaseOrderItem[]
  receipts GoodsReceipt[]
}

model PurchaseOrderItem {
  id          String   @id @default(uuid())
  poId        String
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unit        String?
  unitPrice   Decimal? @db.Decimal(14, 2)
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
}

model GoodsReceipt {
  id          String   @id @default(uuid())
  grnNumber   String   @unique
  projectId   String?
  poId        String?
  receivedAt  DateTime @default(now())
  quantity    Decimal? @db.Decimal(12, 2)
  remarks     String?

  project Project?       @relation(fields: [projectId], references: [id])
  po      PurchaseOrder? @relation(fields: [poId], references: [id])
  inspections QualityInspection[]
}

// ---------------------------------------------------------------------------
// Production
// ---------------------------------------------------------------------------

model ProductionOrder {
  id          String   @id @default(uuid())
  productionId String  @unique
  projectId   String
  statusCode  String   @default("NOT_STARTED")
  remarks     String?
  createdAt   DateTime @default(now())

  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  operations ProductionOperation[]
}

model ProductionOperation {
  id                String    @id @default(uuid())
  productionOrderId String
  operationCode     String
  name              String
  plannedQty        Decimal?  @db.Decimal(12, 2)
  completedQty      Decimal?  @db.Decimal(12, 2)
  startDate         DateTime?
  targetDate        DateTime?
  completedDate     DateTime?
  assignedTeam      String?
  statusCode        String    @default("NOT_STARTED")
  remarks           String?
  sortOrder         Int       @default(0)

  productionOrder ProductionOrder    @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  updates         ProductionUpdate[]
}

model ProductionUpdate {
  id          String   @id @default(uuid())
  operationId String
  message     String
  quantity    Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  operation   ProductionOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Quality
// ---------------------------------------------------------------------------

model QualityInspection {
  id            String    @id @default(uuid())
  inspectionId  String    @unique
  projectId     String
  typeCode      String
  inspectedAt   DateTime  @default(now())
  inspectorId   String?
  quantity      Decimal?  @db.Decimal(12, 2)
  resultCode    String
  defect        String?
  remarks       String?
  reworkRequired Boolean  @default(false)
  documentId    String?
  goodsReceiptId String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspector    User?         @relation(fields: [inspectorId], references: [id])
  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
}

// ---------------------------------------------------------------------------
// Installation, punch points, handover
// ---------------------------------------------------------------------------

model Installation {
  id            String   @id @default(uuid())
  projectId     String
  statusCode    String   @default("NOT_STARTED")
  readinessCode String?
  readinessReason String?
  remarks       String?

  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visits      InstallationVisit[]
  activities  InstallationActivity[]
  readiness   SiteReadinessItem[]
}

model SiteReadinessItem {
  id              String  @id @default(uuid())
  installationId  String
  itemCode        String
  label           String
  statusCode      String  @default("NOT_READY")
  reason          String?
  installation    Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, itemCode])
}

model InstallationVisit {
  id               String   @id @default(uuid())
  installationId   String
  visitDate        DateTime
  siteEngineerId   String?
  team             String?
  workCompleted    String?
  progressPercent  Decimal? @db.Decimal(5, 2)
  issues           String?
  remarks          String?
  createdAt        DateTime @default(now())

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  siteEngineer User?        @relation(fields: [siteEngineerId], references: [id])
}

model InstallationActivity {
  id             String    @id @default(uuid())
  installationId String
  activityCode   String
  label          String
  statusCode     String    @default("NOT_STARTED")
  sortOrder      Int       @default(0)
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
}

model PunchPoint {
  id             String    @id @default(uuid())
  punchId        String    @unique
  projectId      String
  description    String
  location       String?
  priorityCode   String?
  assignedToId   String?
  dueDate        DateTime?
  statusCode     String    @default("OPEN")
  completedAt    DateTime?
  remarks        String?
  photoDocumentId String?
  createdAt      DateTime  @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation(fields: [assignedToId], references: [id])
}

model Handover {
  id                    String    @id @default(uuid())
  projectId             String
  handoverDate          DateTime
  customerRepresentative String?
  sahayRepresentativeId String?
  customerAccepted      Boolean   @default(false)
  remarks               String?
  documentId            String?
  createdAt             DateTime  @default(now())

  project             Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sahayRepresentative User?   @relation("HandoverSahayRep", fields: [sahayRepresentativeId], references: [id])
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  projectId     String
  invoiceDate   DateTime
  amount        Decimal   @db.Decimal(14, 2)
  currency      String    @default("INR")
  dueDate       DateTime?
  statusCode    String    @default("INVOICED")
  remarks       String?
  createdAt     DateTime  @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  paidAt      DateTime
  amount      Decimal  @db.Decimal(14, 2)
  method      String?
  reference   String?
  remarks     String?
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// Existing Aiven `stf` enquiry records. Mapped read-only-safe onto the live `leads` table.
model StfLead {
  id                 String    @id @db.Uuid
  leadCode           String    @unique @map("lead_code")
  customerId         String?   @map("customer_id") @db.Uuid
  title              String
  source             String?
  status             String
  ownerId            String?   @map("owner_id") @db.Uuid
  departmentId       String?   @map("department_id") @db.Uuid
  estimatedValue     Decimal?  @map("estimated_value") @db.Decimal
  currency           String?
  notes              String?
  submittedAt        DateTime? @map("submitted_at")
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @map("created_at")
  updatedAt          DateTime  @map("updated_at")
  details            Json
  checklist          Json
  companyName        String?   @map("company_name")
  industry           String?
  contactPerson      String?   @map("contact_person")
  designation        String?
  mobile             String?
  contactEmail       String?   @map("contact_email")
  companyAddress     String?   @map("company_address")
  siteLocation       String?   @map("site_location")
  customerType       String?   @map("customer_type")
  leadDate           DateTime? @map("lead_date") @db.Date
  priority           String?
  poValue            Decimal?  @map("po_value") @db.Decimal
  paymentStatus      String?   @map("payment_status")
  paymentTerms       String?   @map("payment_terms")
  lastSubmittedBy    String?   @map("last_submitted_by") @db.Uuid
  sendBackReason     String?   @map("send_back_reason")
  sendBackCorrection String?   @map("send_back_correction")
  rejectedReason     String?   @map("rejected_reason")
  isArchived         Boolean   @default(false) @map("is_archived")
  sourceOther        String?   @map("source_other")
  quotationAuthority String?   @map("quotation_authority")
  quotationId        String?   @map("quotation_id") @db.Uuid
  kos                String?
  location           String?
  branch             String?
  product            String?
  product1           String?   @map("product_1")
  outputRequired     String?   @map("output_required")
  basicValue         Decimal?  @map("basic_value") @db.Decimal
  typeOfStorage      String?   @map("type_of_storage")

  @@map("leads")
}
